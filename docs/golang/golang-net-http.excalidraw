    {
      "id": "IwSrjkjWxwP5ZsKKsL-FE",
      "type": "text",
      "x": -3890.1604622454247,
      "y": -359.06067403301563,
      "width": 1049.3994140625,
      "height": 945,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#b2f2bb66",
      "fillStyle": "solid",
      "strokeWidth": 4,
