      "opacity": 100,
      "groupIds": [
        "H2AhwB8X4Cw6pOmgeqE89"
      ],
      "frameId": null,
      "index": "b01",
      "roundness": null,
      "seed": 967381684,
      "version": 175,
      "versionNonce": 425964212,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1742652763722,
      "link": null,
      "locked": false,
      "text": "package main\n\nimport (\n    \"fmt\"\n    \"net/http\"\n)\n\nfunc myfunc(w http.ResponseWriter, r *http.Request) {\n    fmt.Fprintf(w, \"hi\")\n}\n\nfunc main() {\n    // 更多http.Server的字段可以根据情况初始化\n    server := http.Server{\n        Addr:         \":8080\",\n        ReadTimeout:  0,\n        WriteTimeout: 0,\n    }\n    http.HandleFunc(\"/\", myfunc)\n    server.ListenAndServe()\n}",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "package main\n\nimport (\n    \"fmt\"\n    \"net/http\"\n)\n\nfunc myfunc(w http.ResponseWriter, r *http.Request) {\n    fmt.Fprintf(w, \"hi\")\n}\n\nfunc main() {\n    // 更多http.Server的字段可以根据情况初始化\n    server := http.Server{\n        Addr:         \":8080\",\n        ReadTimeout:  0,\n        WriteTimeout: 0,\n    }\n    http.HandleFunc(\"/\", myfunc)\n    server.ListenAndServe()\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
